{
  "name": "tauri-plugin-mcp",
  "version": "0.3.5",
  "private": true,
  "description": "Cross-platform Tauri test automation plugin via MCP",
  "repository": {
    "type": "git",
    "url": "https://github.com/DaveDev42/tauri-plugin-mcp.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.29.2",
  "type": "module",
  "bin": {
    "tauri-mcp": "./packages/tauri-mcp/dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./packages/tauri-plugin-mcp-api/dist/index.js",
      "types": "./packages/tauri-plugin-mcp-api/dist/index.d.ts"
    },
    "./api": {
      "import": "./packages/tauri-plugin-mcp-api/dist/index.js",
      "types": "./packages/tauri-plugin-mcp-api/dist/index.d.ts"
    }
  },
  "main": "./packages/tauri-plugin-mcp-api/dist/index.js",
  "types": "./packages/tauri-plugin-mcp-api/dist/index.d.ts",
  "scripts": {
    "build": "pnpm -r build",
    "prepare": "pnpm build",
    "typecheck": "pnpm -r typecheck",
    "check:versions": "node scripts/check-versions.mjs",
    "release": "node scripts/release.mjs",
    "bump": "node scripts/release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@tauri-apps/api": "^2.0.0",
    "zod": "^3.24.1"
  },
  "pnpm": {
    "overrides": {
      "qs": ">=6.14.1"
    }
  }
}
